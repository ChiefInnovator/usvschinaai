      "approve": true,
      "matchCommandLine": true
    }
  },
  "python.envFile": "${workspaceFolder}/.env",
  "python.terminal.useEnvFile": true,
  "chat.agentSkillsLocations": {
    ".agents/skills": true,
    ".github/skills": true,
